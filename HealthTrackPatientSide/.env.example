# Public Supabase keys only (safe for Vite). Never put service_role here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Relative /api via Vite proxy for Sanctum first-party cookies
VITE_API_BASE_URL=/api

# Patient auth is phone + auto username (0001…). Optional SMS via API SEMAPHORE_API_KEY.
