# Public Supabase keys only (safe for Vite). Never put service_role here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Relative /api (Vite proxy) so Sanctum cookies are first-party in local/dev.
# Production: same-origin API path or set full URL + SESSION_SECURE_COOKIE=true + SESSION_SAME_SITE=none if cross-site.
#VITE_API_BASE_URL=/api
VITE_API_URL=https://your-api.example.com
VITE_HEATMAP_API_BASE_URL=https://your-heatmap-api.example.com
# Optional: match backend account manager config for UI visibility.
VITE_ACCOUNT_MANAGER_NAME="Your Account Manager"
VITE_ACCOUNT_MANAGER_EMAIL=manager@example.com

# Do NOT use VITE_GEMINI_API_KEY or VITE_RESEND_API_KEY — those belong on the API server only.
# Rotate any keys that were previously exposed as VITE_* immediately.
