APP_NAME=HealthTrackAPI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
# Multi-instance / production: use redis (preferred) or database (sessions table already migrated).
# SESSION_DRIVER=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_STORE=redis
# Or: SESSION_DRIVER=database  then ensure `php artisan migrate` created `sessions`.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP: false. Production HTTPS: true (also auto when APP_ENV=production if unset)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE_STAFF=ht_staff_session
SESSION_COOKIE_PATIENT=ht_patient_session

# Comma-separated hosts that may send Sanctum SPA cookies (same-origin / Vite proxy in local).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Production checklist ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.your-domain.tld
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.your-domain.tld   (if API + SPA share parent domain)
# SESSION_DRIVER=redis   (or database) — file sessions break multi-instance
# SANCTUM_STATEFUL_DOMAINS=staff.your-domain.tld,patient.your-domain.tld
# CORS_ALLOWED_ORIGINS=https://staff.your-domain.tld,https://patient.your-domain.tld
# Prefer same-origin SPA→/api proxy so cookies stay first-party.

# Supabase (server-side only — never expose service_role to Vite)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

RESEND_API_KEY=
RESEND_FROM="HealthTrack RHU <onboarding@resend.dev>"
